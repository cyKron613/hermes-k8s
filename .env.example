# Namespace used by the helper scripts
NAMESPACE=hermes
K8S_NAMESPACE=hermes
K8S_DEPLOYMENT=hermes-stack

# Local Hermes data to seed into PVCs
HERMES_HOME=$HOME/.hermes
HERMES_WEBUI_DEFAULT_WORKSPACE=$HOME/workspace

# Remote paths inside the seed pod
REMOTE_HERMES_HOME=/home/hermes/.hermes
REMOTE_WORKSPACE=/home/hermes/workspace

# Optional overrides for the seed helper
POD=hermes-seed-env
CONTAINER=seed-env